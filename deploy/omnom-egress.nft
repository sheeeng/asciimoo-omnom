# Apply with: nft -D omnom_uid=<dedicated service UID> -f omnom-egress.nft
# See docs/network-security.md before applying, especially for containers/DNS.
# Replaces only this table, atomically; does not flush the host ruleset.
add table inet omnom_egress
delete table inet omnom_egress

table inet omnom_egress {
    set blocked_ipv4 {
        type ipv4_addr
        flags interval
        elements = {
            0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
            169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24,
            192.88.99.0/24, 192.168.0.0/16, 198.18.0.0/15,
            198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4,
            168.63.129.16
        }
    }
    set blocked_ipv6 {
        type ipv6_addr
        flags interval
        elements = { 2001::/23, 2001:db8::/32, 2002::/16, 3fff::/20 }
    }

    # Populate exact destinations required by this deployment. For example,
    # elements = { 10.0.0.53 . 53 } in BOTH DNS sets, or a database IP . 5432
    # in allowed_tcp4. These grants affect all traffic from the service UID.
    set allowed_tcp4 { type ipv4_addr . inet_service; }
    set allowed_udp4 { type ipv4_addr . inet_service; }
    set allowed_tcp6 { type ipv6_addr . inet_service; }
    set allowed_udp6 { type ipv6_addr . inet_service; }

    chain output {
        type filter hook output priority filter; policy accept;
        meta skuid $omnom_uid jump restricted
    }

    chain restricted {
        # Permit replies to incoming web/proxy connections, not existing
        # outbound connections to prohibited targets.
        ct direction reply accept

        ip daddr . tcp dport @allowed_tcp4 accept
        ip daddr . udp dport @allowed_udp4 accept
        ip6 daddr . tcp dport @allowed_tcp6 accept
        ip6 daddr . udp dport @allowed_udp6 accept

        # Docker DNATs 127.0.0.11:53 to an internal listener port before this
        # hook. Honor an explicit DNS exception using the original tuple.
        ip daddr 127.0.0.11 ct original ip daddr 127.0.0.11 ct original proto-dst 53 meta l4proto tcp ct original ip daddr . ct original proto-dst @allowed_tcp4 accept
        ip daddr 127.0.0.11 ct original ip daddr 127.0.0.11 ct original proto-dst 53 meta l4proto udp ct original ip daddr . ct original proto-dst @allowed_udp4 accept

        ip daddr @blocked_ipv4 counter reject with icmpx type admin-prohibited
        ip6 daddr != 2000::/3 counter reject with icmpx type admin-prohibited
        ip6 daddr @blocked_ipv6 counter reject with icmpx type admin-prohibited
    }
}
